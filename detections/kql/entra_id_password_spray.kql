// ==============================================================================
// Query: Potential Password Spraying via Microsoft Entra ID (Azure AD)
// MITRE ATT&CK: T1110.003 (Password Spraying)
// Author: acab7667
// Description: Detects multiple distinct user accounts failing login with "Invalid Username or Password" 
//              (ResultType 50126) from the same external IP address within a 15-minute window.
// ==============================================================================

let timeframe = 15m;
let spray_threshold = 5; // Bilangan akaun unik minimum untuk trigger alert

SigninLogs
| where TimeGenerated >= ago(timeframe)
| where ResultType == "50126" // Error: Invalid username or password or Invalid on-premises username or password
| summarize 
    TargetAccountsCount = dcount(UserPrincipalName),
    TargetAccounts = make_set(UserPrincipalName, 20),
    FailureCount = count(),
    Applications = make_set(AppDisplayName, 10),
    UserAgents = make_set(UserAgent, 5),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, Location
| where TargetAccountsCount >= spray_threshold
// Semak sama ada IP ini mempunyai log masuk yang berjaya dalam tempoh yang sama
| join kind=leftouter (
    SigninLogs
    | where TimeGenerated >= ago(timeframe)
    | where ResultType == "0" // 0 = Success
    | summarize SuccessfulAccounts = make_set(UserPrincipalName, 10) by IPAddress
) on IPAddress
| project 
    FirstSeen,
    LastSeen,
    SourceIP = IPAddress,
    Location,
    TargetAccountsCount,
    TargetAccounts,
    SuccessfulAccounts,
    CompromiseSuspected = isnotempty(SuccessfulAccounts),
    FailureCount,
    Applications,
    UserAgents
| order by TargetAccountsCount desc
